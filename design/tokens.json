{
  "$schema": "./tokens.schema.json",
  "version": 1,
  "source": {
    "brand": "sandrogekeler/kapitel-kapital-wiki",
    "file": "src/styles/tokens.css",
    "seeded": "2026-09-28",
    "note": "The neutrals, hairlines, fonts, radii and motion are the wiki's own values. fg-soft and the chapter accents come from docs/HANDOFF.md and the design reference; see docs/adr/0008-design-tokens.md for why the wiki is not the file this app builds from yet."
  },
  "color": {
    "surface": {
      "bg-sunken": {
        "dark": { "hex": "#08080a" },
        "light": { "hex": "#e9e9ec" }
      },
      "bg": { "dark": { "hex": "#0c0c0e" }, "light": { "hex": "#f7f7f8" } },
      "bg-raised": {
        "dark": { "hex": "#131316" },
        "light": { "hex": "#ffffff" }
      },
      "bg-raised-2": {
        "dark": { "hex": "#1a1a1f" },
        "light": { "hex": "#fcfcfd" }
      },
      "bg-hover": {
        "dark": { "hex": "#212127" },
        "light": { "hex": "#eeeef1" }
      },
      "bg-cover": { "dark": { "hex": "#000000" }, "light": { "hex": "#000000" } }
    },
    "text": {
      "fg": { "dark": { "hex": "#ededf0" }, "light": { "hex": "#14141a" } },
      "fg-soft": {
        "dark": { "hex": "#c8c8cf" },
        "light": { "hex": "#2e2e38" }
      },
      "fg-muted": {
        "dark": { "hex": "#a5a5ae" },
        "light": { "hex": "#4c4c58" }
      },
      "fg-faint": {
        "dark": { "hex": "#8c8c97" },
        "light": { "hex": "#63636f" }
      }
    },
    "line": {
      "line": {
        "dark": { "hex": "#ffffff", "alpha": 0.09 },
        "light": { "hex": "#000000", "alpha": 0.11 }
      },
      "line-strong": {
        "dark": { "hex": "#ffffff", "alpha": 0.17 },
        "light": { "hex": "#000000", "alpha": 0.2 }
      }
    },
    "chapter": {
      "luxemburg": {
        "dark": { "hex": "#e0aa4e" },
        "light": { "hex": "#8a6512" }
      },
      "lichdenstein": {
        "dark": { "hex": "#5cbfa2" },
        "light": { "hex": "#1a6b55" }
      },
      "frangfurd": {
        "dark": { "hex": "#7cbfe0" },
        "light": { "hex": "#1c6a8e" }
      }
    },
    "status": {
      "success": {
        "dark": { "hex": "#8fcf7a" },
        "light": { "hex": "#3d7a2b" }
      },
      "warning": {
        "dark": { "hex": "#e0aa4e" },
        "light": { "hex": "#8a6512" }
      },
      "danger": { "dark": { "hex": "#ef7a5e" }, "light": { "hex": "#b23e21" } }
    },
    "storage": {
      "storage-terrain": {
        "dark": { "hex": "#6fa8dc" },
        "light": { "hex": "#2c5f8a" }
      },
      "storage-map": {
        "dark": { "hex": "#5cbfa2" },
        "light": { "hex": "#1a6b55" }
      },
      "storage-saves": {
        "dark": { "hex": "#9cc46a" },
        "light": { "hex": "#4b6e1d" }
      },
      "storage-screenshots": {
        "dark": { "hex": "#e0aa4e" },
        "light": { "hex": "#8a6512" }
      },
      "storage-logs": {
        "dark": { "hex": "#b48ad6" },
        "light": { "hex": "#6b3f8c" }
      },
      "storage-mods": {
        "dark": { "hex": "#e0849a" },
        "light": { "hex": "#9a3a4f" }
      },
      "storage-other": {
        "dark": { "hex": "#6c6c78" },
        "light": { "hex": "#a8a8b2" }
      }
    },
    "brand": {
      "logo-gradient-top": { "dark": { "hex": "#f9ae9f" }, "light": null },
      "logo-gradient-bottom": { "dark": { "hex": "#6d3939" }, "light": null }
    }
  },
  "type": {
    "family": {
      "ui": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ],
      "display": ["Fraunces", "Iowan Old Style", "Georgia", "serif"],
      "mono": [
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    },
    "size": {
      "unit": "px",
      "scale": {
        "2xs": 11,
        "xs": 12,
        "sm": 13,
        "base": 14,
        "md": 16,
        "lg": 17,
        "xl": 20,
        "2xl": 26,
        "display": { "size": 76, "lineHeight": 0.95, "tracking": -0.01 }
      }
    },
    "weight": { "body": 400, "medium": 500, "semibold": 600 },
    "tracking": {
      "unit": "em",
      "scale": { "control": 0.01, "label": 0.06, "eyebrow": 0.08 }
    },
    "variation": {
      "display": { "SOFT": 0, "WONK": 0 }
    }
  },
  "radius": {
    "unit": "px",
    "scale": { "sm": 6, "md": 8, "lg": 10, "pill": 999 }
  },
  "motion": {
    "duration": { "unit": "ms", "scale": { "fast": 140, "reveal": 200, "page": 320, "grace": 300, "slow": 420, "drift": 900, "panorama": 180000, "dwell": 3780, "cover": 2400, "breathe": 16000, "tooltip": 2000, "spin": 1000, "morph": 900, "switch": 600, "lean": 700 } },
    "easing": {
      "standard": [0.22, 0.61, 0.36, 1],
      "out": [0.16, 1, 0.3, 1],
      "glide": [0.45, 0, 0.15, 1],
      "travel": [0.4, 0, 0.2, 1],
      "settle": [0.33, 0, 0.2, 1],
      "leave": [0.55, 0, 0.75, 0.2]
    }
  },
  "layout": {
    "unit": "px",
    "sidebar": 264,
    "sidebarCompact": 95,
    "hero": 440,
    "titlebar": 40,
    "titlebarMac": 52,
    "controlsMac": 80,
    "scrollbar": 6,
    "slide": 32,
    "drift": 20,
    "revealRise": 4,
    "title": 68,
    "playMin": 240,
    "icon": { "2xs": 10, "xs": 14, "sm": 16, "md": 18, "stroke": 1.2 },
    "window": {
      "width": 1280,
      "height": 800,
      "minWidth": 720,
      "minHeight": 240
    },
    "compact": {
      "width": 880,
      "height": 700,
      "hysteresis": 40,
      "gap": 4,
      "title": 400,
      "titleIdle": 160,
      "short": 340,
      "rise": 12,
      "titleShort": 190
    },
    "splash": { "width": 720, "height": 405 }
  },
  "effect": {
    "hoverBrightness": 1.08,
    "focusRing": { "width": 2, "offset": 2 },
    "scrim": { "unit": "%", "edge": 96, "mid": 78, "midAt": 42, "far": 18, "wash": 84, "tile": 58 },
    "accent": { "unit": "%", "wash": 12, "edge": 42 },
    "artPending": { "tint": 6, "line": 8, "cell": 48, "cellThumb": 8 },
    "motionBlur": 4,
    "revealBlur": 2,
    "glow": { "blur": 18, "strength": 40 },
    "tileBlur": 14,
    "tileTint": 75,
    "panorama": { "fov": 90, "tilt": 15, "bleed": 0.5 },
    "cover": { "unit": "%", "art": 40, "spot": 36, "blur": 36 },
    "panel": { "grow": 2.6, "lean": 0.08, "blur": 2, "dim": 0.28, "dimHover": 0.42, "shade": 85, "shadeFrom": 30 }
  }
}
